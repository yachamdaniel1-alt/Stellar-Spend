# Secret scanning via gitleaks — blocks commit if secrets are detected.
# Single source of truth: scripts/secret-scan.sh (scans the working tree
# with the project's .gitleaks.toml config; exits non-zero when a secret
# is found or gitleaks is not installed).
bash scripts/secret-scan.sh || exit 1

# Lint and format only the files staged for this commit.
# Rules for each file type live under "lint-staged" in package.json.
npx lint-staged
