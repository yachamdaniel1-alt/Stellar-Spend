{
  "name": "stellar-spend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/mobile"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --hostname localhost --port 3001",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "bundle:report": "ANALYZE=true next build && node scripts/bundle-size-report.js",
    "start": "next start",
    "lint": "npx -y -p eslint@9.39.4 -p @typescript-eslint/parser@8.46.1 -p @typescript-eslint/eslint-plugin@8.46.1 -p eslint-plugin-react@7.37.5 -p eslint-plugin-react-hooks@5.2.0 -p @next/eslint-plugin-next@15.2.0 eslint . --max-warnings 50",
    "type:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:snapshots": "vitest --run --reporter=verbose",
    "test:snapshots:update": "vitest --run --update",
    "test:snapshots:validate": "node scripts/validate-snapshots.js",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "audit:contracts": "bash ./scripts/audit-contracts.sh",
    "audit:check": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "routes:audit": "node scripts/audit-api-routes.cjs",
    "secret:scan": "bash scripts/secret-scan.sh",
    "secret:scan:history": "bash scripts/secret-scan.sh --history",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "dead-code": "knip",
    "dead-code:ci": "knip --reporter compact",
    "storybook:check-orphans": "node scripts/check-orphaned-stories.js",
    "storybook:fix-orphans": "node scripts/check-orphaned-stories.js --fix",
    "license:check": "node scripts/check-licenses.js",
    "license:report": "node scripts/check-licenses.js --report",
    "type:coverage": "type-coverage",
    "type:coverage:detail": "type-coverage --detail",
    "generate:bindings": "ts-node --project tsconfig.json scripts/generate-contract-bindings.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix --max-warnings 50",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.758.0",
    "@sentry/nextjs": "^10.46.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^14.6.1",
    "@stellar-spend/shared": "*",
    "@zxing/browser": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "dompurify": "^3.2.4",
    "next": "^15.5.14",
    "pg": "^8.21.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@next/bundle-analyzer": "^16.2.1",
    "@types/dompurify": "^3.0.5",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@stryker-mutator/core": "^7.3.0",
    "@stryker-mutator/typescript-checker": "^7.3.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.13.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser-playwright": "^4.1.1",
    "@vitest/coverage-v8": "^4.1.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "15.2.0",
    "eslint-plugin-storybook": "^10.4.6",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^5.88.1",
    "license-checker": "^25.0.1",
    "lint-staged": "^15.5.2",
    "msw": "^2.15.0",
    "node-mocks-http": "^1.14.1",
    "playwright": "^1.61.1",
    "prettier": "^3.4.2",
    "storybook": "^10.4.6",
    "xlsx": "^0.18.5",
    "type-coverage": "^2.29.7",
    "typescript": "5.7.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.1"
  }
}